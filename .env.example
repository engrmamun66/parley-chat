# Variables
# Parley backend API base (parley-backend), including /api/v1 — e.g. http://127.0.0.1:8001/api/v1
# Set → tickets are created on the backend (POST /widget/tickets, auth: publicKey pk_live_…).
# Empty → local demo mode (no backend, data kept in the browser).
VITE_API_BASE_URL=
# WebSocket URL for real-time events, e.g. wss://ws.parley.chat/widget
# Leave empty to fall back to polling the REST API.
VITE_SOCKET_URL=
