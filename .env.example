# Variables
# Base URL of the Parley widget REST API, e.g. https://api.parley.chat/widget/v1
# Leave empty to run the widget in local demo mode (no backend, data kept in the browser).
VITE_API_BASE_URL=
# WebSocket URL for real-time events, e.g. wss://ws.parley.chat/widget
# Leave empty to fall back to polling the REST API.
VITE_SOCKET_URL=
