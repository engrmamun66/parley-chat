<%- include('partials/head') %>
<section class="hero small">
  <div class="wrap">
    <p class="eyebrow">Contact us</p>
    <h1>We're here to help.</h1>
    <p class="lead">The fastest way to reach us is the chat bubble in the corner. You can also write to us below.</p>
  </div>
</section>

<section class="wrap contact">
  <div class="card">
    <% if (sent) { %>
      <h3>Thanks<%= name ? ', ' + name : '' %>!</h3>
      <p>Your message was received (test site — nothing was actually sent).</p>
      <a class="btn" href="/contact-us">Send another</a>
    <% } else { %>
      <form method="post" action="/contact-us">
        <label>Name <input name="name" required></label>
        <label>Email <input name="email" type="email" required></label>
        <label>Message <textarea name="message" rows="5" required></textarea></label>
        <button class="btn" type="submit">Send message</button>
      </form>
    <% } %>
  </div>
  <div class="prose">
    <h2>Visit us</h2>
    <p>Bryggen 12, 5003 Bergen, Norway<br>Mon–Fri, 9:00–17:00</p>
    <h2>Call us</h2>
    <p>+47 55 00 00 00</p>
    <h2>Support hours</h2>
    <p>Live chat is staffed 7 days a week, 8:00–22:00 CET. Outside those hours, raise a ticket in the chat and we'll email you back.</p>
  </div>
</section>
<%- include('partials/foot') %>
