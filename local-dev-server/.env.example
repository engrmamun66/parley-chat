# Port for this test website
PORT=467

# Where the chat widget is loaded from:
#   dist  → built bundle ../dist/parley-live-chat.js   (run `npm run build` in the project root)
#   dev   → live Vite dev server (run `npm run dev` in the project root) — edits show up instantly
#   auto  → dev when the Vite dev server is running, otherwise dist
WIDGET_SOURCE=auto
VITE_DEV_URL=http://localhost:5173

# Widget settings passed to window.ParleySettings
PARLEY_PUBLIC_KEY=pk_local_dev
PARLEY_BUSINESS_NAME=Harbor & Pine
PARLEY_BRAND_COLOR=#1F5C45
